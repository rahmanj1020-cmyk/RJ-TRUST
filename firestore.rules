rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection ping test collection
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && incoming().phone is string;
      allow delete: if isValidId(userId);
    }

    // Requests Collection (Deposits & Withdrawals)
    match /requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) && incoming().amount is number && incoming().type in ['deposit', 'withdraw'];
      allow update: if isValidId(requestId);
      allow delete: if isValidId(requestId);
    }

    // Financial Transactions Ledger
    match /transactions/{txId} {
      allow read: if true;
      allow create: if isValidId(txId) && incoming().amount is number;
      allow update: if isValidId(txId);
      allow delete: if isValidId(txId);
    }

    // Support Chat Messages
    match /supportMessages/{msgId} {
      allow read: if true;
      allow create: if isValidId(msgId) && incoming().text is string && incoming().text.size() <= 1000;
      allow update, delete: if isValidId(msgId);
    }

    // Global Admin Settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }
  }
}
