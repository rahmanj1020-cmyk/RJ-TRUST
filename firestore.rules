rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Transactions collection
    match /transactions/{document=**} {
      allow read, write: if true;
    }

    // Support Messages collection
    match /supportMessages/{document=**} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{document=**} {
      allow read, write: if true;
    }

    // Marketing Team collection
    match /marketingTeam/{document=**} {
      allow read, write: if true;
    }

    // Requests collection
    match /requests/{document=**} {
      allow read, write: if true;
    }

    // Investments collection
    match /investments/{document=**} {
      allow read, write: if true;
    }

    // Prize Bonds collection
    match /prize_bonds/{document=**} {
      allow read, write: if true;
    }

    // Audit Ledger collection
    match /audit_ledger/{document=**} {
      allow read, write: if true;
    }

    // Default fallback for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
