rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if request is from document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users collection: users can read/update their own profile (cannot modify role); admin full access
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
      allow delete: if isAdmin();
    }

    // Transactions collection: users can read their own transactions; admin full access
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Investments collection: users can manage their investments; admin full access
    match /investments/{investmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Prize Bonds collection: users can view/buy their bonds
    match /prize_bonds/{bondId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Support Messages collection: user access to their messages
    match /supportMessages/{messageId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Marketing Team collection: restricted to authenticated users (read) & admin (write)
    match /marketingTeam/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Requests collection: user request tracking
    match /requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Audit Ledger collection: immutable ledger; read by user/admin, write by admin
    match /audit_ledger/{ledgerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Default fallback: deny all unhandled collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
