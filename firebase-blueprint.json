{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-blueprint-schema/main/schema.json",
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "agent"] },
        "balance": { "type": "number" },
        "depositBalance": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] }
      }
    },
    "Investment": {
      "collection": "investments",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "investedAmount": { "type": "number" },
        "dailyROI": { "type": "number" },
        "totalROI": { "type": "number" },
        "durationDays": { "type": "number" },
        "claimedDays": { "type": "number" },
        "lastClaimedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
        "createdAt": { "type": "string" }
      }
    },
    "Transaction": {
      "collection": "transactions",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "roi_claim", "referral_bonus", "prize_bond"] },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "accountNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "completed"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "PrizeBond": {
      "collection": "prize_bonds",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bondNumber": { "type": "string" },
        "series": { "type": "string" },
        "drawDate": { "type": "string" },
        "prizeWon": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "won", "expired"] },
        "purchasedAt": { "type": "string" }
      }
    },
    "SupportMessage": {
      "collection": "supportMessages",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sender": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "MarketingMember": {
      "collection": "marketingTeam",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "assignedAgents": { "type": "array" },
        "status": { "type": "string" }
      }
    },
    "UserRequest": {
      "collection": "requests",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "AuditLedger": {
      "collection": "audit_ledger",
      "fields": {
        "blockIndex": { "type": "number" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "previousHash": { "type": "string" },
        "hash": { "type": "string" },
        "details": { "type": "string" }
      }
    }
  }
}
